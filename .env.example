# --- Cron protection -------------------------------------------------------
# Long random string. Vercel sends it automatically to /api/cron as a bearer token.
CRON_SECRET=

# --- Text model (Google Gemini API) ----------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Output token budget. Raise it if a long reply gets cut off.
GEMINI_MAX_TOKENS=4000

# --- Image model (Cloudflare Worker from automation.py) --------------------
# Full worker URL, e.g. https://image-worker.you.workers.dev
IMAGE_API_URL=
IMAGE_API_KEY=

# --- LinkedIn app ----------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Printed by /api/auth/callback after connecting. Prefer the refresh token;
# it keeps the job running without manual re-auth.
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Versioned REST API release, exactly YYYYMM (not YYYYMMDD). Each release is supported
# for about a year; bump it when a run fails with 426. Latest at build time: 202610.
LINKEDIN_API_VERSION=202610

# --- Content controls (optional) ------------------------------------------
POST_TOPIC=
POST_TONE=direct, practical, a little opinionated
POST_AUDIENCE=engineers and technical founders
POST_WITH_IMAGE=true

# --- URLs (optional) -------------------------------------------------------
# PUBLIC_BASE_URL=https://your-app.vercel.app
# LINKEDIN_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
